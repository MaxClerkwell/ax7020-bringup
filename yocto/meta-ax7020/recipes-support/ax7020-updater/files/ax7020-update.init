#!/bin/sh
### BEGIN INIT INFO
# Provides:          ax7020-update
# Required-Start:    $network $remote_fs
# Required-Stop:
# Default-Start:     5
# Default-Stop:
# Short-Description: fetch the latest image and kexec into it
### END INIT INFO
#
# Runs once after boot, detached, a little later than dropbear: if the update
# fails the maintenance system stays up and reachable over SSH.
CONF=/etc/ax7020-update.conf
DELAY=${DELAY:-15}
case "$1" in
start)
    [ -r "$CONF" ] && . "$CONF"
    if [ -z "${IMAGE_URL:-}" ]; then
        echo "ax7020-update: no IMAGE_URL, staying in the maintenance system"
        exit 0
    fi
    echo "ax7020-update: will fetch $IMAGE_URL in ${DELAY}s"
    setsid sh -c "sleep $DELAY; /usr/bin/ax7020-update 2>&1 | while read -r l; do echo \"\$l\" > /dev/kmsg; done" \
        >/dev/null 2>&1 </dev/null &
    ;;
stop|restart|reload|force-reload) ;;
status) [ -n "${IMAGE_URL:-}" ] && echo "configured: $IMAGE_URL" || echo "not configured" ;;
*) echo "Usage: $0 {start|status}"; exit 1 ;;
esac
exit 0
